schemaVersion: 1.0
name: {{ .Name }}
description: Installs NICE DCV server and Amazon SSM Agent for fabrica workstation create.

phases:
  - name: build
    steps:
      - name: InstallDCV
        action: ExecuteBash
        inputs:
          commands:
            - |
              set -euo pipefail
              export DEBIAN_FRONTEND=noninteractive
              apt-get update -q
              # xterm satisfies /etc/X11/Xsession's requirement for a terminal
              # emulator (or a session manager, window manager, or user
              # ~/.xsession). Without one the boot-created DCV session aborts
              # a few seconds after Xsession starts. binutils provides ar,
              # used below to extract each deb's _gpgbuilder signature member.
              apt-get install -y wget gnupg binutils xvfb x11-xserver-utils dbus-x11 xdg-user-dirs xterm

              # NICE GPG key: pin the primary-key fingerprint and fail closed
              # if the downloaded key does not match, so a tampered key file
              # can never be trusted on import.
              wget -q https://d1uj6qtbmh3dt5.cloudfront.net/NICE-GPG-KEY

              # Isolated throwaway keyring: the import and every gpg
              # --verify below run against this home, never the image
              # default, so unrelated keys cannot satisfy the gate and
              # nothing lands in the base keyring.
              GNUPGHOME="$(mktemp -d /tmp/fabrica-gnupg.XXXXXX)"
              export GNUPGHOME
              NICE_KEY_FPR="5B9EEBC864449701F6CE566A11B5C70A170C6114"
              # --show-keys / --import-options show-only previews the key
              # file without importing it: it must hold exactly one
              # primary key, and that key's fingerprint must be the
              # pinned one, before anything is imported.
              keycheck="$(gpg --batch --no-tty --show-keys --import-options show-only --with-colons --keyid-format long NICE-GPG-KEY 2>/dev/null || true)"
              pubcount="$(printf '%s\n' "$keycheck" | grep -c '^pub:' || true)"
              primaryfpr="$(printf '%s\n' "$keycheck" | awk -F: '$1 == "pub" {p = 1; next} p && $1 == "fpr" {print $10; exit}')"
              if [ "$pubcount" -ne 1 ] || [ "$primaryfpr" != "$NICE_KEY_FPR" ]; then
                echo "ERROR: NICE-GPG-KEY must contain exactly one primary key with fingerprint $NICE_KEY_FPR (pubs: $pubcount, primary fpr: ${primaryfpr:-<none>}); refusing to import"
                exit 1
              fi
              gpg --batch --no-tty --yes --import NICE-GPG-KEY || {
                echo "ERROR: NICE GPG key import failed"
                exit 1
              }
              # The isolated keyring must hold exactly one primary key,
              # and that primary must be the pinned one (subkeys of the
              # primary are fine). A second primary could emit an extra
              # VALIDSIG line and hide a wrong-key signature.
              keyringcheck="$(gpg --batch --no-tty --with-colons --list-keys 2>/dev/null)"
              keyringpubs="$(printf '%s\n' "$keyringcheck" | grep -c '^pub:' || true)"
              keyringprimary="$(printf '%s\n' "$keyringcheck" | awk -F: '$1 == "pub" {p = 1; next} p && $1 == "fpr" {print $10; exit}')"
              if [ "$keyringpubs" -ne 1 ] || [ "$keyringprimary" != "$NICE_KEY_FPR" ]; then
                echo "ERROR: isolated keyring does not hold exactly the pinned NICE primary key after import (pubs: $keyringpubs, primary: ${keyringprimary:-<none>})"
                exit 1
              fi

              # Pinned DCV tarball (2026.0-24952) with a hard SHA256 check. The
              # hash is pinned here rather than fetched from the same CDN, so a
              # tampered CDN cannot swap the build.
              wget -q https://d1uj6qtbmh3dt5.cloudfront.net/2026.0/Servers/nice-dcv-2026.0-24952-ubuntu2204-x86_64.tgz
              echo "52651a93844ce3d5ad918ee7666b007bb2a1c7ff7cf68dc50692e6b18efaa35a  nice-dcv-2026.0-24952-ubuntu2204-x86_64.tgz" | sha256sum -c -

              tar -xzf nice-dcv-2026.0-24952-ubuntu2204-x86_64.tgz
              dcvdir=$(find . -maxdepth 1 -type d -name 'nice-dcv-*' | head -n1)
              test -n "$dcvdir"
              cd "$dcvdir"

              # Verify every .deb's GPG signature against the imported NICE
              # key before installing any of them.
              #
              # Method (per the official DCV admin guide):
              #   https://docs.aws.amazon.com/dcv/latest/adminguide/setting-up-installing-linux-x11-installation.html
              #   https://docs.aws.amazon.com/dcv/latest/adminguide/setting-up-installing-linux-x11-post-installation-checks.html
              # The guide describes the packages as "digitally signed with a
              # secure GPG signature" and specifies GPG verification against
              # the imported key. It also says to import NICE-GPG-KEY-SECRET
              # (URL https://d1uj6qtbmh3dt5.cloudfront.net/NICE-GPG-KEY-SECRET),
              # which is a live 404 as of 2026-10-18; the public
              # NICE-GPG-KEY fetched above is the working file. The guide's
              # suggested dpkg-sig check is unusable on this base image:
              # dpkg-sig 0.13.1+nmu4 (Ubuntu 22.04) whitelists only
              # control.tar, control.tar.gz and control.tar.xz, so it exits
              # BADSIG with rc=2 on all seven correctly-signed 2026.0 debs,
              # which use control.tar.zst. We therefore verify the embedded
              # _gpgbuilder signature member directly with GPG — the method
              # the guide documents — and re-check the manifest digests it
              # covers (MD5, SHA1, and byte size per member) so a tampered
              # member is caught even if the GPG layer is bypassed. The
              # signature gate reads gpg's machine status on a dedicated
              # fd (fd 3) and requires exactly one anchored VALIDSIG line
              # whose signing-key fingerprint field is the pinned key
              # (valid: the pinned NICE key has no signing subkey, so the
              # primary signs directly and the two fingerprints match);
              # BADSIG, ERRSIG, EXPKEYSIG, REVKEYSIG and NO_PUBKEY fail.
              # The manifest is parsed from gpg's verified --output
              # (the data the signature covers), and its member names
              # must equal the archive's ar members exactly, in order.
              verify_deb() {
                local d="$1"
                local abs work manifest line rest md5 sha1 size name filesseen=0
                case "$d" in /*) abs="$d";; *) abs="$(pwd)/$d";; esac
                work="$(mktemp -d /tmp/chk.XXXXXX)"
                # Exact member binding, checked BEFORE extraction so a
                # hostile member name can never be written anywhere: the
                # archive must hold exactly the three ar members listed
                # in the signed manifest plus the _gpgbuilder signature
                # member — nothing else. No duplicates, no unlisted
                # members, no '/' in any member name (an ar member named
                # a path could write outside the working dir), and no
                # '..' path component (traversal).
                local arnames
                arnames="$( ( cd "$work" && ar t "$abs" ) 2>/dev/null || true)"
                if [ "$(printf '%s\n' "$arnames" | grep -c .)" -ne 4 ]; then
                  rm -rf "$work"
                  echo "ERROR: $d must contain exactly 3 ar members plus _gpgbuilder (got: $(printf '%s' "$arnames" | tr '\n' ' '))"
                  return 1
                fi
                if [ "$(printf '%s\n' "$arnames" | sort | uniq -d | grep -c .)" -ne 0 ]; then
                  rm -rf "$work"
                  echo "ERROR: duplicate member names in $d"
                  return 1
                fi
                if printf '%s\n' "$arnames" | grep -q '/'; then
                  rm -rf "$work"
                  echo "ERROR: member name containing '/' in $d"
                  return 1
                fi
                if printf '%s\n' "$arnames" | grep -qE '(^|/)\.\.(/|$)'; then
                  rm -rf "$work"
                  echo "ERROR: member name containing a '..' path component in $d"
                  return 1
                fi
                ( cd "$work" && ar x "$abs" ) >/dev/null 2>&1 || {
                  rm -rf "$work"
                  echo "ERROR: ar extraction failed for $d"
                  return 1
                }
                if [ ! -f "$work/_gpgbuilder" ]; then
                  rm -rf "$work"
                  echo "ERROR: no _gpgbuilder member in $d"
                  return 1
                fi
                # Signature gate: gpg status goes to a dedicated fd 3,
                # human text is discarded separately, and the status
                # stream must contain exactly one anchored VALIDSIG
                # whose signing-key fingerprint field is the pinned NICE
                # key.
                # Any BADSIG/ERRSIG/EXPKEYSIG/REVKEYSIG/NO_PUBKEY line
                # fails.
                local vstat rc=0
                vstat="$work/vstat"
                gpg --batch --no-tty --status-fd 3 --verify "$work/_gpgbuilder" >"$work/vout" 2>"$work/verr" 3>"$vstat" || rc=$?
                if grep -Eq '^\[GNUPG:\] (BADSIG|ERRSIG|EXPKEYSIG|REVKEYSIG|NO_PUBKEY) ' "$vstat"; then
                  rm -rf "$work"
                  echo "ERROR: bad gpg signature status in $d: $(grep -E '^\[GNUPG:\] (BADSIG|ERRSIG|EXPKEYSIG|REVKEYSIG|NO_PUBKEY) ' "$vstat" | head -n1 | cut -c13-80)"
                  return 1
                fi
                if [ "$(grep -Ec '^\[GNUPG:\] VALIDSIG ' "$vstat")" -ne 1 ]; then
                  rm -rf "$work"
                  echo "ERROR: expected exactly one VALIDSIG status line for $d (got $(grep -Ec '^\[GNUPG:\] VALIDSIG ' "$vstat"))"
                  return 1
                fi
                # The first field of a VALIDSIG line is the signing
                # key's fingerprint. It must equal the pinned NICE key;
                # that is a correct equality check because the pinned
                # NICE key has no signing subkey, so the primary key
                # signs directly and the signing-key fingerprint IS the
                # pinned primary fingerprint. (A wrong key's signature
                # reports the wrong fingerprint here even if the signed
                # cleartext embeds the pin in a decoy line.)
                validsig_fpr="$(grep -E '^\[GNUPG:\] VALIDSIG ' "$vstat" | sed 's/^\[GNUPG:\] VALIDSIG //' | awk '{print $1}')"
                if [ "$validsig_fpr" != "$NICE_KEY_FPR" ]; then
                  rm -rf "$work"
                  echo "ERROR: VALIDSIG signing-key fingerprint in $d (${validsig_fpr:-<none>}) is not the pinned NICE key"
                  return 1
                fi
                if [ "$rc" -ne 0 ]; then
                  rm -rf "$work"
                  echo "ERROR: gpg verification failed for $d (rc=$rc): $(head -n1 "$work/verr")"
                  return 1
                fi
                # Parse the manifest from gpg's verified cleartext output
                # (--output), never from the raw _gpgbuilder file: the
                # body is the data the signature actually covers.
                gpg --batch --no-tty --status-fd 3 --verify --output "$work/manifest" "$work/_gpgbuilder" >/dev/null 2>"$work/verr2" 3>"$work/vstat2" || {
                  rm -rf "$work"
                  echo "ERROR: gpg --output of the verified manifest failed for $d: $(head -n1 "$work/verr2")"
                  return 1
                }
                if [ "$(grep -Ec '^\[GNUPG:\] VALIDSIG ' "$work/vstat2")" -ne 1 ]; then
                  rm -rf "$work"
                  echo "ERROR: manifest re-verification did not produce exactly one VALIDSIG for $d"
                  return 1
                fi
                manifest="$(cat "$work/manifest")"
                # Manifest names must equal the archive members exactly,
                # in order: debian-binary, control.tar.*, data.tar.*.
                local mnames
                # Member lines are tab-indented: <md5> <sha1> <size> <name>.
                # Header lines (Version/Signer/Date/Role/Files) are not, so
                # only tab-indented lines are member lines; the name is the
                # fourth space-separated field after the leading tab.
                mnames="$(printf '%s\n' "$manifest" | awk 'substr($0, 1, 1) == "\t" {sub(/^\t/, ""); print $4}')"
                local expected
                expected="$( ( cd "$work" && ar t "$abs" ) 2>/dev/null | grep -v '^_gpgbuilder$' )"
                if [ "$mnames" != "$expected" ]; then
                  rm -rf "$work"
                  echo "ERROR: manifest members do not match the archive members of $d in name or order (manifest: $(printf '%s' "$mnames" | tr '\n' ' '); archive: $(printf '%s' "$expected" | tr '\n' ' '))"
                  return 1
                fi
                if [ "$(printf '%s\n' "$mnames" | grep -c .)" -ne 3 ]; then
                  rm -rf "$work"
                  echo "ERROR: manifest in $d must list exactly 3 members (got $(printf '%s\n' "$mnames" | grep -c .))"
                  return 1
                fi
                # The three members must be exactly the deb layout, in
                # order: debian-binary, control.tar.*, data.tar.*.
                case "$(printf '%s\n' "$mnames" | sed -n 1p)" in
                  debian-binary) ;;
                  *)
                    rm -rf "$work"
                    echo "ERROR: first manifest member of $d must be debian-binary (got $(printf '%s\n' "$mnames" | sed -n 1p))"
                    return 1
                    ;;
                esac
                if ! printf '%s\n' "$mnames" | sed -n 2p | grep -q '^control\.tar\.'; then
                  rm -rf "$work"
                  echo "ERROR: second manifest member of $d must be control.tar.* (got $(printf '%s\n' "$mnames" | sed -n 2p))"
                  return 1
                fi
                if ! printf '%s\n' "$mnames" | sed -n 3p | grep -q '^data\.tar\.'; then
                  rm -rf "$work"
                  echo "ERROR: third manifest member of $d must be data.tar.* (got $(printf '%s\n' "$mnames" | sed -n 3p))"
                  return 1
                fi
                while IFS= read -r line; do
                  case "$line" in *$'\t'*) ;; *) continue ;; esac
                  rest="${line#*$'\t'}"
                  read -r md5 sha1 size name <<<"$rest"
                  filesseen=$((filesseen + 1))
                  if [ ! -f "$work/$name" ]; then
                    rm -rf "$work"
                    echo "ERROR: manifest member $name missing from archive in $d"
                    return 1
                  fi
                  if [ "$(md5sum "$work/$name" | awk '{print $1}')" != "$md5" ]; then
                    rm -rf "$work"
                    echo "ERROR: md5 mismatch for $name in $d"
                    return 1
                  fi
                  if [ "$(sha1sum "$work/$name" | awk '{print $1}')" != "$sha1" ]; then
                    rm -rf "$work"
                    echo "ERROR: sha1 mismatch for $name in $d"
                    return 1
                  fi
                  if [ "$(stat -c%s "$work/$name")" != "$size" ]; then
                    rm -rf "$work"
                    echo "ERROR: size mismatch for $name in $d"
                    return 1
                  fi
                done <<<"$manifest"
                if [ "$filesseen" -ne 3 ]; then
                  rm -rf "$work"
                  echo "ERROR: digest check covered $filesseen members in $d (want 3)"
                  return 1
                fi
                rm -rf "$work"
              }
              for deb in *.deb; do
                verify_deb "$deb"
              done

              apt-get install -y ./nice-dcv-server_*.deb ./nice-xdcv_*.deb ./nice-dcv-web-viewer_*.deb
              systemctl enable dcvserver
      - name: EnsureSSMAgent
        action: ExecuteBash
        inputs:
          commands:
            - |
              set -euo pipefail
{{ indent 14 .EnsureSSM }}

  - name: validate
    steps:
      - name: VerifyDCVAndSSM
        action: ExecuteBash
        inputs:
          commands:
            - set -euo pipefail
            - command -v dcv
            - command -v xsetroot
            - command -v dbus-launch
            - command -v xterm
            - systemctl is-enabled dcvserver
            - |
{{ indent 14 .RequireSSM }}
