schemaVersion: 1.0
name: {{ .Name }}
description: Installs NICE DCV server and Amazon SSM Agent for fabrica workstation create.

phases:
  - name: build
    steps:
      - name: InstallDCV
        action: ExecuteBash
        inputs:
          commands:
            - |
              set -euo pipefail
              export DEBIAN_FRONTEND=noninteractive
              apt-get update -q
              apt-get install -y wget gnupg xvfb
              wget -q https://d1uj6qtbmh3dt5.cloudfront.net/NICE-GPG-KEY
              gpg --import NICE-GPG-KEY
              wget -q https://d1uj6qtbmh3dt5.cloudfront.net/nice-dcv-ubuntu2204-x86_64.tgz
              tar -xzf nice-dcv-ubuntu2204-x86_64.tgz
              cd nice-dcv-*
              apt-get install -y ./nice-dcv-server_*.deb ./nice-xdcv_*.deb ./nice-dcv-web-viewer_*.deb
              systemctl enable dcvserver
      - name: EnsureSSMAgent
        action: ExecuteBash
        inputs:
          commands:
            - |
              set -euo pipefail
{{ indent 14 .EnsureSSM }}

  - name: validate
    steps:
      - name: VerifyDCVAndSSM
        action: ExecuteBash
        inputs:
          commands:
            - set -euo pipefail
            - command -v dcv
            - systemctl is-enabled dcvserver
            - |
{{ indent 14 .RequireSSM }}
