schemaVersion: 1.0
name: {{ .Name }}-{{ .Install }}
description: Installs Horde {{ .Version }} ({{ .Install }} install) for use with fabrica horde create{{ if eq .Install "docker" }}; bakes the compose stack and server image into the AMI{{ end }}.

phases:
  - name: build
    steps:
      # The stock jammy base has no AWS CLI: the docker bake pulls the
      # server image from ECR and the native path syncs binaries from S3.
      # It lands at /usr/local/bin/aws, which is not on the SSM session
      # PATH — invoke it by full path in SSM payloads (docs/horde-ami.md).
      - name: InstallAwsCliV2
        action: ExecuteBash
        inputs:
          commands:
            - |
              set -euo pipefail
{{ indent 14 (awsCliInstall) }}
{{- if eq .Install "docker" }}
      - name: InstallDocker
        action: ExecuteBash
        inputs:
          commands:
            - set -euo pipefail
            - curl -fsSL https://get.docker.com | sh
            - systemctl enable docker
            - usermod -aG docker ubuntu
      # Writes /etc/horde/docker-compose.yml + globals.json + server.json
      # (the paths the horde unit and cloud-init use), then pulls and tags
      # the server image from the account ECR repository using the instance
      # role and pre-pulls the dependency images. ecr:GetAuthorizationToken
      # must be allowed on Resource "*"; see docs/horde-ami.md for the IAM
      # policy and the GHCR -> ECR mirror step (the GHCR image is private
      # and needs read:packages scope on the operator side).
      - name: BakeHordeStack
        action: ExecuteBash
        inputs:
          commands:
            - |
{{ indent 14 (dockerBake .Version) }}
      - name: InstallHordeSystemdUnit
        action: ExecuteBash
        inputs:
          commands:
            - set -euo pipefail
            - |
              cat >/etc/systemd/system/horde.service <<'UNIT'
{{ indent 14 (hordeDockerUnit) }}
              UNIT
            - systemctl daemon-reload
            - systemctl enable horde
{{- else }}
      - name: InstallDotNet
        action: ExecuteBash
        inputs:
          commands:
            - set -euo pipefail
            - wget -q https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb -O /tmp/ms.deb
            - dpkg -i /tmp/ms.deb
            - apt-get update -q
            - apt-get install -y dotnet-sdk-8.0
      - name: InstallMongoDB
        action: ExecuteBash
        inputs:
          commands:
            - set -euo pipefail
            - curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc | gpg -o /usr/share/keyrings/mongodb-7.0.gpg --dearmor
            - echo 'deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-7.0.gpg] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse' >/etc/apt/sources.list.d/mongodb-org-7.0.list
            - apt-get update -q
            - apt-get install -y mongodb-org
            - systemctl enable mongod
      - name: InstallRedis
        action: ExecuteBash
        inputs:
          commands:
            - set -euo pipefail
            - apt-get install -y redis-server
            - systemctl enable redis-server
      - name: InstallHordeBinary
        action: ExecuteBash
        inputs:
          commands:
            - set -euo pipefail
            - mkdir -p /opt/horde /etc/horde
            - /usr/local/bin/aws s3 sync s3://REPLACE_WITH_YOUR_BUCKET/horde-bin/ /opt/horde/ --exact-timestamps
            - chmod +x /opt/horde/HordeServer
            - |
              cat >/etc/horde/env <<'ENV'
              ASPNETCORE_ENVIRONMENT=Production
              Horde__DataDir=/etc/horde
              ENV
            - |
              cat >/etc/systemd/system/horde.service <<'UNIT'
              [Unit]
              Description=Horde Server
              After=mongod.service redis-server.service
              Requires=mongod.service

              [Service]
              ExecStart=/usr/bin/dotnet /opt/horde/HordeServer.dll
              WorkingDirectory=/opt/horde
              EnvironmentFile=/etc/horde/env
              Restart=on-failure
              RestartSec=5

              [Install]
              WantedBy=multi-user.target
              UNIT
            - systemctl daemon-reload
            - systemctl enable horde
{{- end }}
      - name: EnsureSSMAgent
        action: ExecuteBash
        inputs:
          commands:
            - |
              set -euo pipefail
{{ indent 14 (ensureSSM) }}

  - name: validate
    steps:
      - name: VerifyUnitsEnabled
        action: ExecuteBash
        inputs:
          commands:
            - set -euo pipefail
            - systemctl is-enabled horde
{{- if eq .Install "docker" }}
            - systemctl is-enabled docker
{{- else }}
            - systemctl is-enabled mongod
            - systemctl is-enabled redis-server
{{- end }}
            - |
{{ indent 14 (requireSSM) }}

  - name: test
    steps:
      - name: HordeUnitDiscoverable
        action: ExecuteBash
        inputs:
          commands:
            - systemctl cat horde >/dev/null
