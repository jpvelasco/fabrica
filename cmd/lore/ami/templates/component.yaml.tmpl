schemaVersion: 1.0
name: {{ .Name }}
description: Installs loreserver {{ .Version }} for use with fabrica lore create.

phases:
  - name: build
    steps:
      - name: DownloadPinnedLoreRelease
        action: ExecuteBash
        inputs:
          commands:
            - |
              set -euo pipefail
              # umask 022 so a directory staged by a previous (failed) run,
              # possibly owned by a different user, is not untraversable.
              umask 022
              mkdir -p /tmp/lore-bin
              curl -fsSL --retry 5 -o /tmp/lore-bin/loreserver.tgz "https://github.com/EpicGames/lore/releases/download/v{{ .Version }}/loreserver-v{{ .Version }}-x86_64-unknown-linux-gnu.tar.gz"
              tar -xzf /tmp/lore-bin/loreserver.tgz -C /tmp/lore-bin
              rm -f /tmp/lore-bin/loreserver.tgz
              # The OSS tarball ships loreserver mode 0644; make it
              # executable before the contract check.
              chmod 0755 /tmp/lore-bin/loreserver
              test -x /tmp/lore-bin/loreserver
      - name: InstallLoreContract
        action: ExecuteBash
        inputs:
          commands:
            - |
              cat >/tmp/install-lore.sh <<'SCRIPT'
{{ indent 14 .InstallScript }}
              SCRIPT
            - chmod 0755 /tmp/install-lore.sh
            - /tmp/install-lore.sh

  - name: validate
    steps:
      - name: VerifyLoreContract
        action: ExecuteBash
        inputs:
          commands:
            - |
              cat >/tmp/verify-lore-ami-bake.sh <<'SCRIPT'
{{ indent 14 .BakeVerificationScript }}
              SCRIPT
            - chmod 0755 /tmp/verify-lore-ami-bake.sh
            - /tmp/verify-lore-ami-bake.sh
