schemaVersion: 1.0
name: {{ .Name }}
description: Installs loreserver {{ .Version }} for use with fabrica lore create.

phases:
  - name: build
    steps:
      - name: StageLicensedLoreDistribution
        action: ExecuteBash
        inputs:
          commands:
            - set -euo pipefail
            - mkdir -p /tmp/lore-bin
            - aws s3 sync s3://REPLACE_WITH_YOUR_BUCKET/loreserver-bin/ /tmp/lore-bin/ --exact-timestamps
      - name: InstallLoreContract
        action: ExecuteBash
        inputs:
          commands:
            - |
              cat >/tmp/install-lore.sh <<'SCRIPT'
{{ indent 14 .InstallScript }}
              SCRIPT
            - chmod 0755 /tmp/install-lore.sh
            - /tmp/install-lore.sh

  - name: validate
    steps:
      - name: VerifyLoreContract
        action: ExecuteBash
        inputs:
          commands:
            - |
              cat >/tmp/verify-lore-ami-bake.sh <<'SCRIPT'
{{ indent 14 .BakeVerificationScript }}
              SCRIPT
            - chmod 0755 /tmp/verify-lore-ami-bake.sh
            - /tmp/verify-lore-ami-bake.sh
